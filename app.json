{
  "expo": {
    "name": "Estúdio 2D",
    "slug": "estudio-animacao-2d",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rafaproerd.estudioanimacao2d",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "O Estúdio 2D se conecta ao backend próprio para gerar imagens, animações e montar vídeos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.rafaproerd.estudioanimacao2d"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/estudio-animacao-2d"
    }
  }
}
