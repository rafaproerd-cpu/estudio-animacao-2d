ESTUDIO_RENDER_TOKEN=troque-por-um-token-longo-e-aleatorio
# Opcional: caminho absoluto do FFmpeg se não estiver no PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
# RENDER_OUTPUT_DIR=./outputs
# MAX_CLIPS=80
# MAX_CLIP_BYTES=524288000

# Voz local opcional: instale Piper e coloque modelos .onnx na pasta voices/
# PIPER_PATH=piper
# PIPER_VOICES_DIR=./voices
# MAX_TTS_CHARACTERS=6000

# Motor opcional de imagem SDXL (requer PyTorch/CUDA e Diffusers instalados à parte)
# IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# IMAGE_DEVICE=cuda
# IMAGE_STEPS=25
# IMAGE_MIN_FREE_VRAM_MB=8000
# IMAGE_OUTPUT_DIR=./outputs
# MAX_ACTIVE_IMAGE_JOBS=1

# Motor experimental de vídeo Wan2.2 TI2V 5B (requer repositório oficial, pesos e GPU CUDA)
# WAN_GENERATE_SCRIPT=/opt/Wan2.2/generate.py
# WAN_CHECKPOINT_DIR=/models/Wan2.2-TI2V-5B
# WAN_PYTHON=/opt/wan-venv/bin/python
# WAN_SIZE=1280*704
# WAN_MIN_FREE_VRAM_MB=23000
# WAN_TIMEOUT_SECONDS=10800

# Motor de roteiro gratuito via OpenRouter. Crie uma chave em https://openrouter.ai/keys
# e configure STORY_API_KEY no ambiente do Render. URL e modelo já têm padrões no código.
# STORY_API_KEY=sk-or-v1-...
# STORY_API_URL=https://openrouter.ai/api/v1/chat/completions
# STORY_MODEL=openrouter/free

# Origins allowed to call the API from browser previews (comma-separated; restrict in production)
ESTUDIO_ALLOWED_ORIGINS=https://rafaproerd-cpu.github.io

# Persistent job state and retention (keep this database on the same persistent volume as generated media)
# GENERATION_STATE_DB=/data/outputs/generation_state.sqlite3
JOB_RETENTION_SECONDS=86400

# Generated image/video download links (7 days by default)
GENERATION_DOWNLOAD_TTL_SECONDS=604800

# Strength used by SDXL img2img when reusing a character reference (0.25–0.8)
IMAGE_REFERENCE_STRENGTH=0.55
