ESTUDIO_RENDER_TOKEN=troque-por-um-token-longo-e-aleatorio
# Opcional: caminho absoluto do FFmpeg se não estiver no PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
# RENDER_OUTPUT_DIR=./outputs
# MAX_CLIPS=80
# MAX_CLIP_BYTES=524288000

# Voz local opcional: instale Piper e coloque modelos .onnx na pasta voices/
# PIPER_PATH=piper
# PIPER_VOICES_DIR=./voices
# MAX_TTS_CHARACTERS=6000

# Motor opcional de imagem SDXL (requer PyTorch/CUDA e Diffusers instalados à parte)
# IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# IMAGE_DEVICE=cuda
# IMAGE_STEPS=25
# IMAGE_MIN_FREE_VRAM_MB=8000
# IMAGE_OUTPUT_DIR=./outputs
# MAX_ACTIVE_IMAGE_JOBS=1
# JOB_RETENTION_SECONDS=86400

# Motor experimental de vídeo Wan2.2 TI2V 5B (requer repositório oficial, pesos e GPU CUDA)
# WAN_GENERATE_SCRIPT=/opt/Wan2.2/generate.py
# WAN_CHECKPOINT_DIR=/models/Wan2.2-TI2V-5B
# WAN_PYTHON=/opt/wan-venv/bin/python
# WAN_SIZE=1280*704
# WAN_MIN_FREE_VRAM_MB=24576
# WAN_TIMEOUT_SECONDS=10800
